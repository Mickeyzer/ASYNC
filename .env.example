# Server-only settings. Copy to .env if the key is not already in your environment.
# Leave the key blank in this tracked example.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional WhatsApp integration. Both switches default to off.
UDYAM_WHATSAPP_ENABLED=0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PUBLIC_URL=
UDYAM_WHATSAPP_OUTBOUND_ENABLED=0
WHATSAPP_ACCESS_TOKEN=
# Set the supported Graph version from your Meta application; no implicit version.
WHATSAPP_GRAPH_VERSION=
# Server-only Fernet key for temporary guided answers and queued replies.
WHATSAPP_STATE_KEY=
